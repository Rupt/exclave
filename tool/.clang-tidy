# clang-tidy for the exclave command: the launcher's checks, less what a single-threaded program on the C library does
# by design. Its readdir, strerror and exit are its own to call; a message it prints to a terminal that has gone is
# not a failure it can report anywhere; and an array of strings comes from malloc and goes back to free as a void *,
# which is how C's allocator works.
InheritParentConfig: true
Checks:
  - -concurrency-mt-unsafe
  - -cert-err33-c
  - -bugprone-multi-level-implicit-pointer-conversion
HeaderFilterRegex: "tool/.*"
