#!/bin/sh
# scripts/release-prepare N — the first half of release N (docs/RELEASE.md), everything on this machine: the commit
# that sets VERSION to N, on top of main as origin has it and not pushed; the gate, every step of it, with nothing
# failed and nothing skipped; and the release's files, made by scripts/release in build/release-vN and checked.
# scripts/extra is not run: what it finds becomes a test in the gate, and a release waits on nothing the gate would
# not. Where VERSION is N already, from a run before, it is kept, so a failure is met by a fix in a commit of its own
# and this run again, pushed or not. The inputs are EXCLAVE_TEST_INPUTS's, build/inputs when it is not set, as
# scripts/inputs makes them; logs go under build/release-prepare/. scripts/release-publish N then publishes what this
# made.
set -eu
. "$(dirname -- "$0")/lib.sh"
[ $# -eq 1 ] || {
    echo "usage: scripts/release-prepare N" >&2
    exit 2
}
n=$1
release_head "$n"
inputs=${EXCLAVE_TEST_INPUTS:-$ROOT/build/inputs}
[ -d "$inputs/gcc13.exclave" ] || {
    echo "release-prepare: no $inputs/gcc13.exclave: run scripts/inputs $inputs" >&2
    exit 2
}
git -C "$ROOT" fetch -q origin main
! git -C "$ROOT" ls-remote --exit-code --tags origin "refs/tags/v$n" >/dev/null || {
    echo "release-prepare: origin already has the tag v$n" >&2
    exit 1
}
git -C "$ROOT" merge-base --is-ancestor origin/main HEAD || {
    echo "release-prepare: HEAD lacks commits of origin's main: pull them first" >&2
    exit 1
}
if [ "$(cat "$ROOT/VERSION")" = "$n" ]; then
    echo "release-prepare: VERSION is $n already"
elif [ "$(cat "$ROOT/VERSION")" = "$((n - 1))" ]; then
    printf '%s\n' "$n" >"$ROOT/VERSION"
    git -C "$ROOT" commit -q -m "Set the version to $n" -- VERSION
    echo "release-prepare: committed VERSION $n"
else
    echo "release-prepare: VERSION is $(cat "$ROOT/VERSION"), and release $n is made from VERSION $((n - 1))" >&2
    exit 1
fi
logs=$ROOT/build/release-prepare
rm -rf "$logs" && mkdir -p "$logs"
# the gate passes on its summary line, "gate: 0 failed, 0 skipped, T s", since a skipped step is a check that did not
# run
echo "release-prepare: the gate"
EXCLAVE_TEST_INPUTS=$inputs "$ROOT/scripts/gate" --full "$inputs/gcc13.exclave" >"$logs/gate.log" 2>&1 || :
tail -n 1 "$logs/gate.log" | grep -q "^gate: 0 failed, 0 skipped," || {
    grep -v -e '^built ' -e ' ok ' "$logs/gate.log" >&2
    echo "release-prepare: the gate did not pass; $logs/gate.log has its output" >&2
    exit 1
}
echo "release-prepare: the files"
rm -rf "$release_dir"
"$ROOT/scripts/release" "$release_dir" "$inputs/gcc13.exclave" >"$logs/release.log" 2>&1 || {
    tail -n 20 "$logs/release.log" >&2
    echo "release-prepare: scripts/release failed; $logs/release.log has its output" >&2
    exit 1
}
release_files "$n"
echo "release-prepare: $release_dir holds $release_name; scripts/release-publish $n publishes it"
