#!/bin/sh
# scripts/build — the launchers, from src/ (DESIGN.md 7.1), and the exclave
# command, from tool/ (10).
#
# The launcher is a freestanding ET_DYN object with no PT_INTERP: it runs as a
# program (a wrapper, 6.1) and loads programs itself (7.3). For the machine's
# own architecture it makes, under build/:
#
#   launcher        what every wrapper is a link to, stripped; launcher.debug
#                   keeps the symbols, and launcher.debug-*.ci the call graph
#                   and frames test/stackcheck.py reads
#   launcher-old    the same sources at filter version 3, for the nesting
#                   regression of 17.4: without the syscalls version 4 added,
#                   so that a trap for one of them reaches a handler that must
#                   answer ENOSYS rather than re-issue it
#   launcher-debug  with gcc's undefined-behaviour checks, each a trap
#                   instruction, since the launcher links no runtime to report
#                   one: a failed check kills the program with SIGILL, which
#                   gdb places from launcher-debug.debug. The gate runs the
#                   suite on it.
#   exclave         the exclave command, linked statically, so that the file
#                   runs with nothing beside it; it carries the launcher, and
#                   is built after it
#   exclave-asan    the same under ASan and UBSan, linked dynamically, a
#                   finding exiting 99 (test/sanitize.c), which the gate's
#                   unit step runs on hostile input; left out of a copy of
#                   the sources without the tests, as scripts/reproduce makes
#
#   unpack          the unpack command, from unpack/ (10.1), and
#   fetch           the fetch command, from fetch/: Go, built by the pinned
#                   toolchain in .go/ (scripts/install-go), static and
#                   stripped; where there is no toolchain, as inside an exclave
#                   under scripts/reproduce, a line says so and the C is built
#
# and, on x86-64 with the cross compiler, launcher-aarch64,
# launcher-old-aarch64, exclave-aarch64 and unpack-aarch64, which the matrix
# carries into its arm64 VM. Nothing is built when every output
# is there and no source, LICENSE, this script or lib.sh is newer than the last
# build; a line for each one built. The builds run one after the other, as
# every build here does, so that building never loads the machine with more
# than one compiler (the laptop is in use beside it).
set -u
. "$(dirname -- "$0")/lib.sh"
cd "$ROOT" || exit 2
mkdir -p build || exit 2
stamp=build/.built
native=$(uname -m)
# the build's version (7, 10): the project's version and the commit, -dirty for uncommitted changes; a copy of the
# sources without the checkout, as scripts/reproduce makes, names its commit in the file COMMIT
commit=$(git describe --always --dirty --exclude='*' 2>/dev/null) || commit=$(cat COMMIT 2>/dev/null) || commit=unknown
version=$(sed -n 's/^version = "\(.*\)"/\1/p' pyproject.toml)+$commit
[ "$(cat build/.version 2>/dev/null)" = "$version" ] || fresh=false
cross=$(c_arches | grep -vx "$native")

fresh=${fresh:-true}
sanitized=test/sanitize.c
[ -f "$sanitized" ] || sanitized=
gobuilds=
[ -x "$GO" ] && gobuilds="build/unpack build/fetch"
for f in "$stamp" build/launcher build/launcher-old build/launcher-debug build/exclave ${sanitized:+build/exclave-asan} $gobuilds; do
    [ -e "$f" ] || fresh=false
done
for arch in $cross; do
    [ -e "build/launcher-$arch" ] && [ -e "build/launcher-old-$arch" ] && [ -e "build/exclave-$arch" ] || fresh=false
    [ -z "$gobuilds" ] || [ -e "build/unpack-$arch" ] || fresh=false
done
gosources= # absent from a copy of the sources without the Go, as scripts/reproduce makes
for p in go.mod go.sum fetch unpack; do
    [ -e "$p" ] && gosources="$gosources $p"
done
# shellcheck disable=SC2086  # the Go sources, one word each
if $fresh && [ -z "$(find src tool $sanitized $gosources LICENSE scripts/build scripts/lib.sh -newer "$stamp" | head -n 1)" ]; then
    exit 0
fi

# launcher ARCH OUT ARGS...: OUT.debug from every source, then OUT stripped
# for shipping. The strip keeps .debug_gdb_scripts, the script gdb auto-loads
# (7.6), .dynsym, the six names it reads, and .exclave.license, the licence's
# text, which goes with every copy of the launcher.
launcher() {
    arch=$1 out=$2
    shift 2
    tools=
    [ "$arch" = "$native" ] || tools=$arch-linux-gnu-
    # plain RELA relocations, the only kind reloc_self reads; aarch64's linker
    # does not know the option and warns that it ignores it
    [ "$arch" = aarch64 ] || set -- "$@" -Wl,-z,nopack-relative-relocs
    launcher_cc "$arch" "$@" "-DEXCLAVE_VERSION=\"$version\"" -shared -Wl,-e,_start -Wl,--no-relax -Wl,-z,noexecstack -Wl,-z,norelro \
        -Wl,-Bsymbolic -Wl,--build-id=none -o "$out.debug" src/*.c || return 1
    # a freestanding link binds nothing: no PLT and no undefined symbol (an
    # outline atomic helper of libgcc, say)
    if "${tools}readelf" -d "$out.debug" | grep -q JMPREL; then
        echo "build: $out has a PLT: a call left for a libc or libgcc" >&2
        return 1
    fi
    if "${tools}nm" -u "$out.debug" | grep .; then
        echo "build: $out has undefined symbols" >&2
        return 1
    fi
    "${tools}objcopy" --strip-all --keep-section=.debug_gdb_scripts --keep-section=.exclave.license \
        --keep-section=.exclave.version "$out.debug" "$out" || return 1
    notes=$("${tools}readelf" -n "$out")
    if ! printf '%s\n' "$notes" | grep -Eq '^ +exclave +0x' || ! printf '%s\n' "$notes" | grep -Eq '^ +cont +0x'; then
        echo "build: $out lost a note: the launcher carries exclave and cont (7.4.5)" >&2
        return 1
    fi
    "${tools}readelf" -S -W "$out" | grep -q debug_gdb_scripts || {
        echo "build: $out lost the gdb script" >&2
        return 1
    }
    "${tools}readelf" -p .exclave.license "$out" | grep -q 'MIT License' || {
        echo "build: $out lost the licence" >&2
        return 1
    }
    "${tools}readelf" -p .exclave.version "$out" | grep -qF "exclave $version" || {
        echo "build: $out lost its version" >&2
        return 1
    }
    "${tools}readelf" --dyn-syms "$out" | grep -q exclave_debug_hook || {
        echo "build: $out does not export the gdb hook" >&2
        return 1
    }
    "${tools}readelf" -h "$out" | grep -q 'DYN' || {
        echo "build: $out is not ET_DYN" >&2
        return 1
    }
    echo "built $out ($(stat -c %s "$out") bytes stripped, $arch)"
}

tool() { # tool ARCH OUT ARGS...: the exclave command for ARCH
    arch=$1 out=$2
    shift 2
    compiler=${CC:-gcc}
    [ "$arch" = "$native" ] || compiler=$arch-linux-gnu-gcc
    launcher=build/launcher
    [ "$arch" = "$native" ] || launcher=build/launcher-$arch
    tool_cc "$compiler" "-DLAUNCHER=\"$launcher\"" "-DEXCLAVE_VERSION=\"$version\"" "$@" -o "$out" tool/*.c tool/blobs.S || return 1
    echo "built $out ($(stat -c %s "$out") bytes, $arch)"
}

go_build() { # go_build ARCH OUT PKG: the Go command PKG for ARCH, static (lib.sh: cgo off, paths trimmed) and stripped
    arch=$1 out=$2 pkg=$3
    case $arch in x86_64) goarch=amd64 ;; aarch64) goarch=arm64 ;; *) goarch=$arch ;; esac
    GOOS=linux GOARCH=$goarch "$GO" build -ldflags="-s -w -X main.version=$version" -o "$out" "$pkg" || return 1
    echo "built $out ($(stat -c %s "$out") bytes, $arch)"
}

rm -f "$stamp" build/launcher*.debug-*.ci
# the machine's own launcher first, so that a compile error is told once
launcher "$native" build/launcher -fcallgraph-info=su -dumpdir build/launcher.debug- || exit 1
status=0
launcher "$native" build/launcher-old -DFILTER_VERSION=3 -DEXCLAVE_TEST_OLD || status=1
launcher "$native" build/launcher-debug -fsanitize=undefined -fsanitize-trap=undefined -fsanitize=bounds-strict || status=1
tool "$native" build/exclave -static -s || status=1
if [ -n "$sanitized" ]; then
    tool "$native" build/exclave-asan -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer "$sanitized" || status=1
fi
if [ -n "$gobuilds" ]; then
    go_build "$native" build/unpack ./unpack || status=1
    go_build "$native" build/fetch ./fetch || status=1
    for arch in $cross; do
        go_build "$arch" "build/unpack-$arch" ./unpack || status=1
    done
else
    echo "build: no Go at $GO (scripts/install-go): build/unpack and build/fetch not built"
fi
for arch in $cross; do
    # the command carries the launcher, so is built after it
    { launcher "$arch" "build/launcher-$arch" -fcallgraph-info=su -dumpdir "build/launcher-$arch.debug-" &&
        tool "$arch" "build/exclave-$arch" -static -s; } || status=1
    launcher "$arch" "build/launcher-old-$arch" -DFILTER_VERSION=3 -DEXCLAVE_TEST_OLD || status=1
done
[ $status = 0 ] && touch "$stamp" && printf '%s\n' "$version" >build/.version
exit $status
