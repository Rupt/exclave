#!/bin/sh
# scripts/example DIR — from a clean checkout to a program that runs on any glibc since 2.17, in one script
# (README; DESIGN.md 9, 10). Everything it makes goes under DIR, and nothing anywhere else; a second run
# keeps the fetched files and fetches nothing. The steps, each a command you can run by hand:
#   1. scripts/build builds the launcher.
#   2. exclave-fetch debs downloads Ubuntu 24.04's gcc-13 closure; exclave unpack makes an unwrapped exclave from the files.
#   3. exclave-fetch rpms downloads CentOS 7's glibc; unpacked into an exclave of its own, its tree is copied into the
#      gcc exclave at /opt/sysroot-el7, and the manifest says `data "/opt/sysroot-el7"`: nothing there is wrapped,
#      checked or executed. exclave wrap wraps the exclave, and a shortcut names its gcc.
#   4. hello.c is compiled inside the exclave twice, plainly and against the sysroot, with EXCLAVE_LOG on; objdump shows
#      which glibc symbol versions each output binds; the sysroot one runs on this host and inside the exclave.
#   5. exclave prune keeps, in a copy of the exclave, what the compile touched; that copy compiles the program
#      again, and exclave check reads the new log: the exclave you would ship, and the check you would run on it.
set -eu
. "$(dirname -- "$0")/lib.sh"
here=$ROOT
[ $# -eq 1 ] || {
    echo "usage: scripts/example DIR" >&2
    exit 2
}
mkdir -p "$1" && cd "$1"
dir=$(pwd)
rm -rf gcc.exclave sysroot.exclave hello.exclave hello.c hello hello-plain hello-pruned log && mkdir log # a rerun keeps only the fetched files
exclave() { "$here/build/exclave" "$@"; }
unpack() { "$here/build/exclave" unpack "$@"; }
run() {
    echo "+ $*" >&2
    "$@"
}          # every command shown as it runs
logged() { # logged NAME CMD...: the command and its long output go to log/NAME.log
    name=$1
    shift
    run "$@" >"log/$name.log" 2>&1 || {
        echo "$name failed: see $dir/log/$name.log" >&2
        exit 1
    }
    echo "  $(tail -1 "log/$name.log") ($(grep -c '^warning' "log/$name.log") warnings; log/$name.log)"
}
sysroot=--sysroot=/opt/sysroot-el7 sysroot_b=-B/opt/sysroot-el7/usr/lib64/ # headers from the sysroot; -B for its start files and libc

echo "== 1. the launcher"
run "$here/scripts/build"

# the archives' signing keys, which every index and package is checked against (10.1): Ubuntu's from the
# machine's own keyring package, CentOS 7's fetched once and checked against the hash scripts/inputs pins
ubuntu=/usr/share/keyrings/ubuntu-archive-keyring.gpg
centos=$dir/RPM-GPG-KEY-CentOS-7
[ -e "$centos" ] || {
    url=https://vault.centos.org/7.9.2009/os/x86_64/RPM-GPG-KEY-CentOS-7
    download "$url" "$centos" || exit 1
    [ "$(exclave hash "$centos")" = b3:0f486068ef5f812ec4780aa667408c34cc2a66e7ac15e66d29cc9c534dfe79ca ] || {
        echo "the CentOS 7 key fetched does not match its hash" >&2
        exit 1
    }
}

echo "== 2. a gcc exclave from Ubuntu 24.04 packages"
[ -n "$(ls debs 2>/dev/null)" ] || logged fetch-debs "$here/build/exclave-fetch" debs --keyring "$ubuntu" --out debs gcc-13 libc6-dev
logged unpack unpack gcc.exclave debs/*.deb

echo "== 3. CentOS 7's glibc as a sysroot inside it"
[ -n "$(ls el7 2>/dev/null)" ] || logged fetch-rpms "$here/build/exclave-fetch" rpms --keyring "$centos" --repo https://vault.centos.org/7.9.2009/os/x86_64 --no-base --out el7 glibc glibc-devel glibc-headers kernel-headers libgcc
logged unpack-el7 unpack sysroot.exclave el7/*.rpm
run mkdir -p gcc.exclave/tree/opt # the placeholders are wrap's, which comes after
run cp -a sysroot.exclave/tree gcc.exclave/tree/opt/sysroot-el7
printf '%s\n' "+ printf 'exclave 1\\n\\ndata \"/opt/sysroot-el7\"\\n' > gcc.exclave/.exclave/manifest" >&2
printf 'exclave 1\n\ndata "/opt/sysroot-el7"\n' >gcc.exclave/.exclave/manifest
logged wrap exclave wrap gcc.exclave
run ln -s tree/usr/bin/gcc-13 gcc.exclave/gcc

echo "== 4. a program built inside, run on this host and inside the exclave"
cat >hello.c <<'HELLO'
#include <stdio.h>
int main(void) { printf("hello from an exclave\n"); return 0; }
HELLO
run env EXCLAVE_LOG="$dir/log/plain.log" gcc.exclave/gcc -o hello-plain hello.c
run env EXCLAVE_LOG="$dir/log/hello.log" gcc.exclave/gcc "$sysroot" "$sysroot_b" -o hello hello.c
echo "  log/hello.log: $(wc -l <log/hello.log) lines, one per trapped syscall; the first:"
head -6 log/hello.log | sed "s/^/    /"
versions() { gcc.exclave/tree/usr/bin/objdump -T "$1" | grep -o 'GLIBC_[0-9.]*' | sort -u | tr '\n' ' '; }
echo "  glibc symbol versions bound: hello-plain: $(versions hello-plain) hello: $(versions hello)"
run ./hello
run gcc.exclave/.exclave/launcher "$dir/hello"

echo "== 5. the exclave pruned to what the compile touched, and the checks on it"
run cp -a gcc.exclave hello.exclave
run exclave prune hello.exclave log/hello.log
run env EXCLAVE_LOG="$dir/log/pruned.log" hello.exclave/gcc "$sysroot" "$sysroot_b" -o hello-pruned hello.c
run exclave check hello.exclave log/pruned.log
run ./hello-pruned
count() { find "$1/tree" -type f -o -type l | wc -l; }
echo "  files and symlinks under tree/: $(count gcc.exclave) in gcc.exclave, $(count hello.exclave) in hello.exclave"
echo "example: done; everything is under $dir"
