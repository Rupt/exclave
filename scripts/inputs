#!/bin/sh
# scripts/inputs DIR — the development inputs, remade from the network (DESIGN.md 17): the exclaves the gate
# runs on and the files the examples take. Nothing is kept anywhere but DIR and the fetchers' caches under
# ~/.cache, and both may be empty at any time: whatever is missing is fetched again, and an item DIR already
# has is skipped, so a rerun costs nothing. Afterwards:
#   EXCLAVE_TEST_INPUTS=DIR scripts/gate DIR/gcc13.exclave DIR/alpine.exclave DIR/f42.exclave DIR/clang.exclave
#   EXCLAVE_TEST_INPUTS=DIR EXCLAVE_TEST_SRC=DIR/src EXCLAVE_TEST_SQLITE=DIR/src/sqlite3.c EXCLAVE_TEST_RPMS=DIR/el7 EXCLAVE_TEST_DEBS_ARM64=DIR/debs-arm64 scripts/examples DIR/realsoft.exclave
# The package sets are the ones DESIGN.md measures (10.1, 12, 16.8): the noble gcc-13 and clang-18 closures,
# Alpine 3.21's gcc, Fedora 42's gcc, the noble gcc, g++, make and python3 that test/realsoft.py builds with,
# CentOS 7's glibc for the sysroot of 9, the noble arm64 gcc-13 closure for the emulated row, the exclaves of
# test/workloads.py (valgrind, poppler's pdftotext and a PDF for it, Rust with cargo, CMake with ninja, a Java
# JDK), and the four projects of test/realsoft.py with the SQLite amalgamation of test/bench.py, and Docker's default seccomp profile
# (moby/profiles, Apache-2.0), the version DESIGN.md 15.7 checked, for test/docker_profile.py; and the archives'
# signing keys the fetchers check every index and package against (10), pinned here by hash. The tests themselves
# touch no network.
set -u
. "$(dirname -- "$0")/lib.sh"
repo=$ROOT
[ $# -eq 1 ] || {
    echo "usage: scripts/inputs DIR" >&2
    exit 2
}
[ -x "$repo/build/launcher" ] && [ -x "$repo/build/exclave" ] || {
    echo "build/launcher or build/exclave missing: run scripts/build" >&2
    exit 2
}
dir=$(mkdir -p "$1" && cd "$1" && pwd) || exit 2
mkdir -p "$dir/log" "$dir/src" || exit 2
fails=0

exclave() { "$repo/build/exclave" "$@"; }
unpack() { py -m unpack "$@"; }

fetch() { # fetch NAME FETCHER ARGS...: package files into DIR/NAME through the fetcher's cache
    name=$1
    tool=$2
    shift 2
    if [ -n "$(ls "$dir/$name" 2>/dev/null)" ]; then
        echo "$name: present"
        return 0
    fi
    rm -rf "${dir:?}/$name"
    if py "$repo/fetch/$tool" --out "$dir/$name" "$@" >"$dir/log/$name.log" 2>&1; then
        echo "$name: $(find "$dir/$name" -type f | wc -l) files"
    else
        echo "$name: FAIL, see $dir/log/$name.log"
        rm -rf "${dir:?}/$name"
        fails=$((fails + 1))
        return 1
    fi
}
make_exclave() { # make_exclave NAME PKGDIR: unpack the package files into DIR/NAME.exclave and wrap it
    name=$1
    pkgs=$2
    if grep -q '^tree ' "$dir/$name.exclave/.exclave/hashes" 2>/dev/null; then
        echo "$name.exclave: present"
        return 0
    fi
    rm -rf "$dir/$name.exclave"
    if unpack "$dir/$name.exclave" "$dir/$pkgs"/* >"$dir/log/$name.exclave.log" 2>&1 && exclave wrap "$dir/$name.exclave" >>"$dir/log/$name.exclave.log" 2>&1; then
        echo "$name.exclave: $(grep -c '^pkg ' "$dir/$name.exclave/.exclave/hashes") packages; $(tail -1 "$dir/log/$name.exclave.log")"
    else
        echo "$name.exclave: FAIL, see $dir/log/$name.exclave.log"
        rm -rf "$dir/$name.exclave"
        fails=$((fails + 1))
        return 1
    fi
}
file() { # file URL NAME HASH: one file into DIR/src, verified by its BLAKE2b-256
    url=$1
    name=$2
    hash=$3
    if [ "$(b2sum -l 256 "$dir/src/$name" 2>/dev/null | cut -d' ' -f1)" = "$hash" ]; then
        echo "src/$name: present"
        return 0
    fi
    rm -f "$dir/src/$name"
    if py -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' "$url" "$dir/src/$name" >"$dir/log/$name.log" 2>&1 &&
        [ "$(b2sum -l 256 "$dir/src/$name" | cut -d' ' -f1)" = "$hash" ]; then
        echo "src/$name: fetched"
    else
        echo "src/$name: FAIL (download or hash), see $dir/log/$name.log"
        rm -f "$dir/src/$name"
        fails=$((fails + 1))
        return 1
    fi
}

fedora=https://archives.fedoraproject.org/pub/archive/fedora/linux/releases/42/Everything/x86_64/os
centos=https://vault.centos.org/7.9.2009/os/x86_64
# the archives' signing keys, which the fetchers check every index and package against (10); each pinned here by
# its BLAKE2b-256, so that the key is this file's and not the network's
file https://archive.ubuntu.com/ubuntu/project/ubuntu-archive-keyring.gpg ubuntu-archive-keyring.gpg a216df0d4d5bbe223c5349283b2661d2e0a321fe4c8910eecdbcf7c12ae8fba5
file https://src.fedoraproject.org/rpms/fedora-repos/raw/f42/f/RPM-GPG-KEY-fedora-42-primary RPM-GPG-KEY-fedora-42-primary 25bae133be1906e21720637fa4ece7d816b5f3946304166d98e954663d56dc33
file https://vault.centos.org/7.9.2009/os/x86_64/RPM-GPG-KEY-CentOS-7 RPM-GPG-KEY-CentOS-7 4a088ee35b0355b8a9cc8b611b72ca76280cb34c4b90346ff08abb30fe0b82a0
file https://alpinelinux.org/keys/alpine-devel@lists.alpinelinux.org-6165ee59.rsa.pub alpine-devel@lists.alpinelinux.org-6165ee59.rsa.pub 7022bd8ba8209c32fad8211dfe5e69d66d7eb9424ea90990a28333f3b7318508
ubuntu=$dir/src/ubuntu-archive-keyring.gpg
# any Ubuntu mirror serves, every index being checked against the archive's key; archive.ubuntu.com has served the
# reference machine at 13 kB/s
mirror=http://gb.archive.ubuntu.com/ubuntu
alpine=$dir/src/alpine-devel@lists.alpinelinux.org-6165ee59.rsa.pub
fetch debs-gcc13 debs.py --keyring "$ubuntu" gcc-13 libc6-dev && make_exclave gcc13 debs-gcc13
fetch apks apks.py --key "$alpine" gcc musl-dev binutils make linux-headers && make_exclave alpine apks
fetch rpms-f42 rpms.py --keyring "$dir/src/RPM-GPG-KEY-fedora-42-primary" --repo $fedora --choose glibc-langpack=glibc-minimal-langpack gcc glibc-devel binutils make && make_exclave f42 rpms-f42
fetch debs-clang debs.py --keyring "$ubuntu" clang-18 libc6-dev libgcc-13-dev libstdc++-13-dev binutils && make_exclave clang debs-clang
fetch debs-realsoft debs.py --keyring "$ubuntu" gcc g++ make libc6-dev python3 && make_exclave realsoft debs-realsoft
fetch el7 rpms.py --keyring "$dir/src/RPM-GPG-KEY-CentOS-7" --repo $centos --no-base glibc glibc-devel glibc-headers kernel-headers libgcc
fetch debs-valgrind-gcc debs.py --keyring "$ubuntu" --mirror $mirror valgrind gcc libc6-dev && make_exclave valgrind debs-valgrind-gcc
fetch debs-poppler debs.py --keyring "$ubuntu" --mirror $mirror poppler-utils poppler-data fonts-urw-base35 && make_exclave poppler debs-poppler
fetch debs-rust debs.py --keyring "$ubuntu" --mirror $mirror cargo rustc gcc libc6-dev && make_exclave rust debs-rust
fetch debs-cmake debs.py --keyring "$ubuntu" --mirror $mirror cmake ninja-build gcc g++ libc6-dev && make_exclave cmake debs-cmake
fetch debs-java debs.py --keyring "$ubuntu" --mirror $mirror openjdk-17-jdk-headless libfreetype6 libharfbuzz0b libasound2t64 && make_exclave java debs-java
file https://arxiv.org/pdf/1706.03762v7 attention.pdf 3d56f08914b524d39582df88d31489b197b246bb879406421664896210cb6e70
fetch debs-arm64 debs.py --keyring "$ubuntu" --arch arm64 --mirror http://ports.ubuntu.com/ubuntu-ports gcc-13 libc6-dev
file https://raw.githubusercontent.com/moby/profiles/3c28324314729dbade8287e868eef6338c42807a/seccomp/default.json docker-seccomp.json 3d005310d39ca085839ee4d23373c37c5eaeee073951d1fed335c2553559b846
file https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz zlib-1.3.1.tar.gz ac034b9c7bbd9f8cc38953efaac07145ce0c8993107a1594d5cedd08fdf2a2bc
file https://www.lua.org/ftp/lua-5.4.7.tar.gz lua-5.4.7.tar.gz 7a37bca67359c6917fd330eee4e5d9f50852c27a2f5bce4e40b2b3b02ce18830
file https://www.sqlite.org/2024/sqlite-autoconf-3460100.tar.gz sqlite-autoconf-3460100.tar.gz 12fab9a1ef11d6cb772b7b88ef73102a7c1e02f7ae35f4c2d3263fbe7af706d8
file https://github.com/skvadrik/re2c/releases/download/3.1/re2c-3.1.tar.xz re2c-3.1.tar.xz 24709a9a1658019d3590f2ceb32c6f0b1c16641f87c961e626a4793061efef02
file https://www.sqlite.org/2025/sqlite-amalgamation-3500400.zip sqlite-amalgamation-3500400.zip 96f33f65b7d2fbdfbb0b8261a85c31e0d72dc033da51dca5de1919a9175067c8 &&
    if [ ! -f "$dir/src/sqlite3.c" ]; then
        if py -c 'import sys, zipfile; z = zipfile.ZipFile(sys.argv[1]); [open(sys.argv[2], "wb").write(z.read(n)) for n in z.namelist() if n.endswith("/sqlite3.c")]' \
            "$dir/src/sqlite-amalgamation-3500400.zip" "$dir/src/sqlite3.c"; then
            echo "src/sqlite3.c: extracted"
        else
            echo "src/sqlite3.c: FAIL"
            fails=$((fails + 1))
        fi
    fi
echo "inputs: $fails failed"
exit $fails
