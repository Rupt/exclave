#!/bin/sh
# scripts/inputs DIR [examples] — the development inputs, remade from the network (DESIGN.md 17): the exclaves
# the gate runs on and Docker's seccomp profile, from the distributions' package archives and GitHub alone, and
# with the word examples the files the examples take too, some from their authors' own sites, which a
# continuous-integration run has no business fetching. Nothing is kept anywhere but DIR and the fetchers'
# caches under ~/.cache, and both may be empty at any time: whatever is missing is fetched again, and an item
# DIR already has is skipped, so a rerun costs nothing. Afterwards:
#   EXCLAVE_TEST_INPUTS=DIR scripts/gate DIR/gcc13.exclave
#   EXCLAVE_TEST_INPUTS=DIR scripts/extra DIR/gcc13.exclave DIR/alpine.exclave DIR/f42.exclave DIR/clang.exclave
#   EXCLAVE_TEST_INPUTS=DIR EXCLAVE_TEST_SRC=DIR/src EXCLAVE_TEST_SQLITE=DIR/src/sqlite3.c EXCLAVE_TEST_RPMS=DIR/el7 EXCLAVE_TEST_ARM64=DIR/gcc13-arm64.exclave scripts/examples DIR/realsoft.exclave
# The package sets are the ones DESIGN.md measures (10.1, 12, 16.8): the noble gcc-13 and clang-18 closures,
# Alpine 3.21's gcc, Fedora 42's gcc, the noble gcc, g++, make and python3 that test/realsoft.py builds with,
# CentOS 7's glibc for the sysroot of 9, the noble arm64 gcc-13 closure, made into an exclave with the aarch64
# launcher built here (10.1) for the emulated rows and for the gate on an aarch64 machine, the exclaves of
# test/workloads.py (valgrind, poppler's pdftotext and a PDF for it, Rust with cargo, CMake with ninja, a Java
# JDK, and the judging image of a Hutter Prize entry, clang-18 and lld-18 at the Ubuntu snapshot the entry's
# install.sh pins, with the entry's source package), and the four projects of test/realsoft.py with the SQLite amalgamation of test/bench.py, and Docker's default seccomp profile
# (moby/profiles, Apache-2.0), the version DESIGN.md 15.7 checked, for test/docker_profile.py; and the archives'
# signing keys the fetchers check every index and package against (10), pinned here by hash. The tests themselves
# touch no network.
# shellcheck disable=SC2329  # the items' functions run through item, which shellcheck does not follow
set -u
. "$(dirname -- "$0")/lib.sh"
repo=$ROOT
{ [ $# -eq 1 ] || { [ $# -eq 2 ] && [ "$2" = examples ]; }; } || {
    echo "usage: scripts/inputs DIR [examples]" >&2
    exit 2
}
"$repo/scripts/build" || exit 2 # the launchers and the command, which wrap the exclaves; nothing when up to date
dir=$(mkdir -p "$1" && cd "$1" && pwd) || exit 2
mkdir -p "$dir/log" "$dir/src" || exit 2
fails=0
# The items, a fetch and the exclave made from it or a file, run three at a time, each in the background with its
# lines printed as it ends: a fetch, an unpack and a wrap are each mostly one core and a few hundred MB, so three at
# once stay light beside the machine's other work. A failure leaves a file under DIR/log, counted when all are done,
# since a background item's variables end with it. The signing keys come first, since the fetches read them.
rm -f "$dir"/log/.failed.*
slots=$dir/log/.slots.$$
{ mkfifo "$slots" && exec 3<>"$slots" && rm -f "$slots"; } || exit 2
for slot in 1 2 3; do echo "$slot" >&3; done
item() { # item COMMAND...: COMMAND in the background once a slot is free
    read -r slot <&3
    {
        "$@"
        echo "$slot" >&3
    } &
}
failed() { : >"$dir/log/.failed.$1"; } # failed NAME: an item that failed
counted() {                            # counted: every item done, the failures counted
    wait
    fails=$(find "$dir/log" -name '.failed.*' | wc -l)
}

exclave() { "$repo/build/exclave" "$@"; }
download() { # download URL FILE: through curl or wget, with their retries
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL -A exclave-inputs --connect-timeout 30 --retry 5 --retry-delay 5 --retry-all-errors --retry-connrefused -o "$2" "$1"
    else
        wget -q -U exclave-inputs --timeout=30 --tries=5 --waitretry=5 -O "$2" "$1"
    fi
}
unpack() { "$repo/build/exclave" unpack "$@"; }

fetch() { # fetch NAME KIND ARGS...: package files into DIR/NAME through the fetcher's cache; KIND is debs, apks or rpms
    name=$1
    kind=$2
    shift 2
    if [ -n "$(ls "$dir/$name" 2>/dev/null)" ]; then
        echo "$name: present"
        return 0
    fi
    rm -rf "${dir:?}/$name"
    if "$repo/build/exclave" fetch "$kind" --out "$dir/$name" "$@" >"$dir/log/$name.log" 2>&1; then
        echo "$name: $(find "$dir/$name" -type f | wc -l) files"
    else
        echo "$name: FAIL, see $dir/log/$name.log"
        rm -rf "${dir:?}/$name"
        failed "$name"
        return 1
    fi
}
make_exclave() { # make_exclave NAME PKGDIR [LAUNCHER]: unpack the package files into DIR/NAME.exclave and wrap it
    name=$1
    pkgs=$2
    launcher=${3:-}
    if grep -q '^tree ' "$dir/$name.exclave/.exclave/hashes" 2>/dev/null; then
        echo "$name.exclave: present"
        return 0
    fi
    rm -rf "$dir/$name.exclave"
    # shellcheck disable=SC2086  # the launcher, one word or none
    if unpack "$dir/$name.exclave" "$dir/$pkgs"/* >"$dir/log/$name.exclave.log" 2>&1 && exclave wrap "$dir/$name.exclave" $launcher >>"$dir/log/$name.exclave.log" 2>&1; then
        echo "$name.exclave: $(grep -c '^pkg ' "$dir/$name.exclave/.exclave/hashes") packages; $(tail -1 "$dir/log/$name.exclave.log")"
    else
        echo "$name.exclave: FAIL, see $dir/log/$name.exclave.log"
        rm -rf "$dir/$name.exclave"
        failed "$name.exclave"
        return 1
    fi
}
both() { # both NAME PKGDIR KIND ARGS...: the package files into DIR/PKGDIR, then DIR/NAME.exclave made of them
    exname=$1 pkgdir=$2
    shift 2
    fetch "$pkgdir" "$@" && make_exclave "$exname" "$pkgdir"
}
b3() { # b3 FILE: its BLAKE3-256 as lowercase hex, by the command built here (exclave hash FILE)
    "$repo/build/exclave" hash "$1" 2>/dev/null | sed 's/^b3://'
}
file() { # file URL NAME HASH: one file into DIR/src, verified by its BLAKE3-256
    url=$1
    name=$2
    hash=$3
    if [ "$(b3 "$dir/src/$name")" = "$hash" ]; then
        echo "src/$name: present"
        return 0
    fi
    rm -f "$dir/src/$name"
    # a failed or stalled connection is tried again, five times over about a minute, as scripts/install-uv does
    if download "$url" "$dir/src/$name" >"$dir/log/$name.log" 2>&1 &&
        [ "$(b3 "$dir/src/$name")" = "$hash" ]; then
        echo "src/$name: fetched"
    else
        echo "src/$name: FAIL (download or hash), see $dir/log/$name.log"
        rm -f "$dir/src/$name"
        failed "$name"
        return 1
    fi
}

fedora=https://archives.fedoraproject.org/pub/archive/fedora/linux/releases/42/Everything/x86_64/os
centos=https://vault.centos.org/7.9.2009/os/x86_64
# the archives' signing keys, which the fetchers check every index and package against (10); each pinned here by
# its BLAKE3-256, so that the key is this file's and not the network's
file https://archive.ubuntu.com/ubuntu/project/ubuntu-archive-keyring.gpg ubuntu-archive-keyring.gpg b64faba2f5f4999ac818dbd0ea927cc7f76ca7b31d1aa9510bfb8c0f34eb54e4
file https://src.fedoraproject.org/rpms/fedora-repos/raw/f42/f/RPM-GPG-KEY-fedora-42-primary RPM-GPG-KEY-fedora-42-primary 70651cbc2e636a74c6c70a010b7b33f1fafb58922ee3756f29549e7e3195bc43
file https://alpinelinux.org/keys/alpine-devel@lists.alpinelinux.org-6165ee59.rsa.pub alpine-devel@lists.alpinelinux.org-6165ee59.rsa.pub 279148f0c681a0da044bbc988c7d7a4078e00fe597011c66fe49414ea70e9c63
ubuntu=$dir/src/ubuntu-archive-keyring.gpg
# any Ubuntu mirror serves, every index being checked against the archive's key; archive.ubuntu.com has served the
# reference machine at 13 kB/s
mirror=http://gb.archive.ubuntu.com/ubuntu
alpine=$dir/src/alpine-devel@lists.alpinelinux.org-6165ee59.rsa.pub
# the gate's: its four exclaves, the arm64 gcc exclave, and Docker's default seccomp profile
item both gcc13 debs-gcc13 debs --keyring "$ubuntu" gcc-13 libc6-dev
item both alpine apks apks --key "$alpine" gcc musl-dev binutils make linux-headers
item both f42 rpms-f42 rpms --keyring "$dir/src/RPM-GPG-KEY-fedora-42-primary" --repo $fedora --choose glibc-langpack=glibc-minimal-langpack gcc glibc-devel binutils make
item both clang debs-clang debs --keyring "$ubuntu" clang-18 libc6-dev libgcc-13-dev libstdc++-13-dev binutils
# the aarch64 launcher this machine builds: its own on aarch64, the cross-built one on x86-64 with the cross compiler
case $(uname -m) in
aarch64) aarch64_launcher=$repo/build/launcher ;;
*) aarch64_launcher=$repo/build/launcher-aarch64 ;;
esac
arm64() {
    fetch debs-arm64 debs --keyring "$ubuntu" --arch arm64 --mirror http://ports.ubuntu.com/ubuntu-ports gcc-13 libc6-dev &&
        if [ -x "$aarch64_launcher" ]; then
            make_exclave gcc13-arm64 debs-arm64 "$aarch64_launcher"
        else
            echo "gcc13-arm64.exclave: no aarch64 launcher built here (aarch64-linux-gnu-gcc missing); skipped"
        fi
}
item arm64
item file https://raw.githubusercontent.com/moby/profiles/3c28324314729dbade8287e868eef6338c42807a/seccomp/default.json docker-seccomp.json b5b6b32d9b6c410d6e8c00639ead764745bd4eaf9cb662d2ec25b656e3f17f75
counted
[ "${2-}" = examples ] || {
    echo "inputs: $fails failed (the gate's; scripts/inputs DIR examples fetches the examples' too)"
    exit "$fails"
}

# the examples': test/realsoft.py's packages and sources, the sysroot's CentOS 7 glibc, test/workloads.py's exclaves
# and files, and test/bench.py's SQLite, some from their authors' own sites
file https://vault.centos.org/7.9.2009/os/x86_64/RPM-GPG-KEY-CentOS-7 RPM-GPG-KEY-CentOS-7 0f486068ef5f812ec4780aa667408c34cc2a66e7ac15e66d29cc9c534dfe79ca
item both realsoft debs-realsoft debs --keyring "$ubuntu" gcc g++ make libc6-dev python3
item fetch el7 rpms --keyring "$dir/src/RPM-GPG-KEY-CentOS-7" --repo $centos --no-base glibc glibc-devel glibc-headers kernel-headers libgcc
item both valgrind debs-valgrind-gcc debs --keyring "$ubuntu" --mirror $mirror valgrind gcc libc6-dev
item both poppler debs-poppler debs --keyring "$ubuntu" --mirror $mirror poppler-utils poppler-data fonts-urw-base35
item both rust debs-rust debs --keyring "$ubuntu" --mirror $mirror cargo rustc gcc libc6-dev
item both cmake debs-cmake debs --keyring "$ubuntu" --mirror $mirror cmake ninja-build gcc g++ libc6-dev
item both java debs-java debs --keyring "$ubuntu" --mirror $mirror openjdk-17-jdk-headless libfreetype6 libharfbuzz0b libasound2t64
# the packages cmix-neif 1.0's install.sh installs, at the snapshot it pins (test/workloads.py buildimage)
item both buildimage debs-buildimage debs --keyring "$ubuntu" --snapshot 20260927T160000Z clang-18 lld-18 llvm-18 libclang-rt-18-dev build-essential gawk python3
item file https://marwoelk.de/cmix-neif-1.0/cmix-neif-1.0.tar.gz cmix-neif-1.0.tar.gz 656180fdcf33b407502de2abba2098a29ef58aac947c49b8a88e89805a1d40b5
item file https://arxiv.org/pdf/1706.03762v7 attention.pdf 8110b31b13b21ea79c3cf668f3c5dc2aa20a20927d9956343f2442f0536d6600
item file https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz zlib-1.3.1.tar.gz 207c3b0862cb4e3686f8405f76a98c38dbad9c94bcf4be4b9efca0716aba51ec
item file https://www.lua.org/ftp/lua-5.4.7.tar.gz lua-5.4.7.tar.gz e51c2f347e3185479d5ff95cae8ac77511db486853269443c56bedaa0a6ae629
item file https://www.sqlite.org/2024/sqlite-autoconf-3460100.tar.gz sqlite-autoconf-3460100.tar.gz 023516a598e6109db5002f3a8f452d9cc5e496e200c40881d3bc70d8d7415448
item file https://github.com/skvadrik/re2c/releases/download/3.1/re2c-3.1.tar.xz re2c-3.1.tar.xz 15358a2b6d139d566269a6be1c7c0a179be03b4df59d78e12e02647b8da0b594
sqlite() {
    file https://www.sqlite.org/2025/sqlite-amalgamation-3500400.zip sqlite-amalgamation-3500400.zip 29f027da01fcbecf04e6633b8b878e0e52d4a6b0ed514dd6fc3d92aa240b7a8a &&
        if [ ! -f "$dir/src/sqlite3.c" ]; then
            if py -c 'import sys, zipfile; z = zipfile.ZipFile(sys.argv[1]); [open(sys.argv[2], "wb").write(z.read(n)) for n in z.namelist() if n.endswith("/sqlite3.c")]' \
                "$dir/src/sqlite-amalgamation-3500400.zip" "$dir/src/sqlite3.c"; then
                echo "src/sqlite3.c: extracted"
            else
                echo "src/sqlite3.c: FAIL"
                failed sqlite3.c
            fi
        fi
}
item sqlite
counted
echo "inputs: $fails failed"
exit "$fails"
