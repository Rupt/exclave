#!/bin/sh
# scripts/reproduce EXCLAVE DIR — the launcher built inside EXCLAVE, a gcc exclave, from a copy of the sources under
# DIR (docs/DESIGN.md 10.5): its compiler, its binutils and its shell, and nothing of the machine's, so that
# DIR/build/launcher is the same bytes on any machine the exclave runs on; then, where this checkout has the pinned
# Go (scripts/install-go), the command built here from that launcher, DIR/build/exclave, and DIR/build/exclave-fetch,
# which the toolchain builds the same bytes anywhere from the same sources (lib.sh), and DIR/build/NOTICES, their
# modules' licence texts. Prints the
# BLAKE3-256 of each as b3sum does, by the command (exclave hash FILE): the one built here, or the checkout's where
# there is no Go, as in the matrix's VMs, where the launcher's is printed alone. The commit is the checkout's, or the file COMMIT's in
# a copy of the sources without one, as the matrix carries into its VMs. It runs no Python.
set -eu
. "$(dirname -- "$0")/lib.sh"
[ $# -eq 2 ] || {
    echo "usage: scripts/reproduce EXCLAVE DIR" >&2
    exit 2
}
ex=$(CDPATH='' cd -- "$1" && pwd) dir=$2
cc=
for c in "$ex/tree/usr/bin/$(uname -m)-linux-gnu-gcc-"[0-9]*; do
    [ -e "$c" ] && cc=$(basename -- "$c")
done
[ -n "$cc" ] || {
    echo "reproduce: $ex has no $(uname -m)-linux-gnu-gcc-N" >&2
    exit 2
}
commit=$(git -C "$ROOT" describe --always --dirty --exclude='*' 2>/dev/null) || commit=$(cat "$ROOT/COMMIT")
rm -rf "$dir"
mkdir -p "$dir/scripts"
cp -R "$ROOT/src" "$ROOT/tool" "$ROOT/LICENSE" "$ROOT/VERSION" "$dir/"
rm -f "$dir"/tool/launcher-* # the checkout's copies of its launchers: the command here carries the one built inside
# the command's other packages and its module, for the build here; a copy of the sources without them, as the
# matrix carries into its VMs, builds the launcher alone
for p in unpack fetch go.mod go.sum; do
    [ -e "$ROOT/$p" ] && cp -R "$ROOT/$p" "$dir/"
done
cp "$ROOT/scripts/build" "$ROOT/scripts/lib.sh" "$dir/scripts/"
printf '%s\n' "$commit" >"$dir/COMMIT"
# the exclave's own programs alone on PATH, so that no tool of the machine's takes part
env -i HOME="$dir" PATH="$ex/tree/usr/bin:$ex/tree/bin" CC="$cc" \
    "$ex/tree/usr/bin/sh" "$dir/scripts/build" >"$dir/build.log" 2>&1 || {
    tail -n 20 "$dir/build.log" >&2
    echo "reproduce: the build inside $ex failed; $dir/build.log has its output" >&2
    exit 1
}
built="launcher"
if [ -x "$GO" ] && [ -e "$dir/go.mod" ]; then
    version=$(cat "$dir/VERSION")+$commit
    cp "$dir/build/launcher" "$dir/tool/launcher-$(uname -m)"
    (cd "$dir" && go_build "$(uname -m)" build/exclave ./tool "$version") >>"$dir/build.log" 2>&1 || {
        tail -n 20 "$dir/build.log" >&2
        echo "reproduce: the command's build from $dir failed; $dir/build.log has its output" >&2
        exit 1
    }
    (cd "$dir" && go_build "$(uname -m)" build/exclave-fetch ./fetch/exclave-fetch "$version") >>"$dir/build.log" 2>&1 || {
        tail -n 20 "$dir/build.log" >&2
        echo "reproduce: exclave-fetch's build from $dir failed; $dir/build.log has its output" >&2
        exit 1
    }
    (cd "$dir" && go_notices build/NOTICES ./tool ./fetch/exclave-fetch) >>"$dir/build.log" 2>&1 || {
        tail -n 20 "$dir/build.log" >&2
        echo "reproduce: the notices of the commands' modules could not be written" >&2
        exit 1
    }
    built="$built exclave exclave-fetch"
fi
hasher=$dir/build/exclave
[ -x "$hasher" ] || hasher=$ROOT/build/exclave
[ -x "$hasher" ] || {
    echo "reproduce: no command to hash with, here or at $hasher: run scripts/build" >&2
    exit 2
}
for f in $built; do
    printf '%s  %s\n' "$("$hasher" hash "$dir/build/$f" | sed 's/^b3://')" "$f"
done
