#!/bin/sh
# scripts/gate [--full] EXCLAVE... — the commit gate (DESIGN.md 17), run on the change at hand.
#
# It builds the launchers first (scripts/build), which takes no time when they are up to date. Then
# by default it runs the steps the changed paths can affect: the uncommitted changes, or, in a clean
# tree, the last commit. A launcher source or its build runs everything; the tool, a test or a helper
# runs the steps that exercise it; documents, scripts and settings run the code checks alone; a path
# the rules below do not know runs everything. --full runs every step, whatever changed.
#
# The steps: the code checks (scripts/check), the unit tests under ASan and UBSan, the stack budget,
# and for every exclave given the suite in the given and a random order (and, for the first
# exclave, under the plain terminal's AppArmor label and on build/launcher-debug), the resolution
# oracle, the namespace oracle and the syscall probe; the exclave command's C answers against its
# Python ones while it is ported (test/tool_oracle.py); when EXCLAVE_TEST_INPUTS names the directory
# scripts/inputs filled, the Docker profile run on its src/docker-seccomp.json and dogfood on its
# package sets. No step touches the network. Every step runs in parallel; every driver runs
# build/launcher on a copy of its own (the suite wraps one from the exclave's tree, the others take
# test/tree.py's fresh_exclave), so the exclaves given are never run as they are nor written. One
# line per step with its time, SKIP for an oracle that could not run here; logs under build/gate/.
# Exit status: the number of failed steps.
set -u
. "$(dirname -- "$0")/lib.sh"
here=$ROOT/test
repo=$ROOT
out=$repo/build/gate
full=false
if [ "${1-}" = --full ]; then
    full=true
    shift
fi
[ $# -ge 1 ] || {
    echo "usage: scripts/gate [--full] EXCLAVE..." >&2
    exit 2
}
"$ROOT/scripts/build" || exit 2 # the launchers, unless they are up to date
rm -rf "$out" && mkdir -p "$out" || exit 2
start=$(date +%s)

step() { # step NAME CMD...: in the background, its status and log kept
    name=$1
    shift
    (
        t=$(date +%s)
        "$@" >"$out/$name.log" 2>&1
        echo "$? $(($(date +%s) - t))" >"$out/$name.rc"
    ) &
}
# shellcheck disable=SC2329  # run through step, by name
# the parser, the filter, the scratch pool, the CPU check, the #! rules and the command's BLAKE2b, just built for the host
# under ASan and UBSan, a finding fatal (test/sanitize.c)
unit() {
    sanitized() { # sanitized OUT ARGS...
        o=$1
        shift
        host_cc -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -o "$o" "$@" "$here/sanitize.c"
    }
    sanitized "$out/manifest_test" -DHOST_TEST "$here/manifest_test.c" "$repo/src/manifest.c" "$repo/src/str.c" &&
        "$out/manifest_test" && py "$here/grammar_test.py" --c-parser "$out/manifest_test" &&
        sanitized "$out/filter_test" -DHOST_TEST "$here/filter_test.c" "$repo/src/filter.c" "$repo/src/str.c" &&
        "$out/filter_test" && py "$here/syscalls.py" &&
        sanitized "$out/scratch_test" -DSCRATCH_TEST "$here/scratch_test.c" "$repo/src/scratch.c" &&
        "$out/scratch_test" &&
        sanitized "$out/isa_test" -DHOST_TEST "$here/isa_test.c" "$repo/src/isa.c" "$repo/src/str.c" &&
        "$out/isa_test" &&
        sanitized "$out/str_test" -DHOST_TEST "$here/str_test.c" "$repo/src/str.c" &&
        "$out/str_test" &&
        sanitized "$out/tool_test" "$here/tool_test.c" "$repo/tool/blake2b.c" &&
        "$out/tool_test"
}
# shellcheck disable=SC2329  # run through step, by name
debug_suite() { # debug_suite EXCLAVE NAME: the suite on the launcher with its undefined-behaviour checks
    py "$here/run.py" --exclave "$1" --work "$out/w-$2-debug" --launcher "$repo/build/launcher-debug"
}
# shellcheck disable=SC2329  # run through step, by name
stack() {
    py "$here/stackcheck.py" "$repo"/build/launcher.debug-*.ci || return 1
    if ls "$repo"/build/launcher-aarch64.debug-*.ci >/dev/null 2>&1; then py "$here/stackcheck.py" "$repo"/build/launcher-aarch64.debug-*.ci; fi
}

# What the change can affect. Each flag names a group of steps; a path sets the ones it can affect.
unit=false stack=false suite=false random=false plain=false oracles=false dogfood=false matrix=false port=false
changed=$(cd "$ROOT" && { git diff --name-only HEAD && git ls-files --others --exclude-standard; } | sort -u)
what="uncommitted changes"
if [ -z "$changed" ]; then
    changed=$(cd "$ROOT" && git diff --name-only HEAD~1 HEAD)
    what="the last commit"
fi
for path in $changed; do
    case $path in
    src/* | scripts/build | scripts/lib.sh | LICENSE | .python-version)
        full=true # the launcher and its build, which everything runs, or the Python everything runs on
        matrix=true
        ;;
    scripts/gate) full=true ;; # the gate itself
    exclave/*) unit=true suite=true oracles=true dogfood=true port=true ;;
    tool/*) # the command in C, which the drivers and the VMs run for the commands it answers
        unit=true suite=true port=true matrix=true
        ;;
    test/exclave_cmd.py | test/tool_oracle.py) suite=true port=true ;;
    unpack/*) suite=true random=true dogfood=true ;;
    test/run.py) suite=true random=true ;;
    test/progs/*) suite=true random=true oracles=true ;; # the probe and ro_matrix are programs there too
    test/tree.py) suite=true random=true oracles=true dogfood=true ;;
    test/oracle_*.py | test/docker_profile.py) oracles=true ;;
    test/syscalls.py) unit=true oracles=true ;;
    test/*_test.c | test/grammar_test.py) unit=true ;;
    test/stackcheck.py) stack=true ;;
    test/dogfood.py) dogfood=true ;;
    test/matrix.py | test/vm_run.py) matrix=true ;;
    # scripts/check's alone: documents, settings, the fetchers, the other scripts and drivers
    *.md | docs/* | scripts/* | fetch/* | test/*.py | pyproject.toml | uv.lock | taplo.toml | .gitignore) ;;
    *) full=true ;;
    esac
done
if $full; then
    unit=true stack=true suite=true random=true plain=true oracles=true dogfood=true port=true
    echo "gate: every step ($what${changed:+: $(echo "$changed" | wc -l) paths})"
else
    echo "gate: the steps $what can affect ($(echo "$changed" | wc -l) paths); --full runs every step"
fi
$matrix && echo "gate: the change reaches the VMs; run scripts/matrix before committing it"

step check "$ROOT/scripts/check" # ruff, ty, shellcheck, shfmt and taplo, silent when clean
$unit && step unit unit
$stack && step stack stack
for ex in "$@"; do
    n=$(basename "$ex" .exclave)
    $suite && step "suite-$n" py "$here/run.py" --exclave "$ex" --work "$out/w-$n"
    $random && step "suite-$n-random" py "$here/run.py" --exclave "$ex" --work "$out/w-$n-random" --order random
    if $plain && [ "$ex" = "$1" ] && command -v aa-exec >/dev/null 2>&1 && aa-exec -p unconfined true 2>/dev/null; then                                # the plain terminal's
        step "suite-$n-plain" aa-exec -p unconfined "$UV" run --quiet --project "$ROOT" python "$here/run.py" --exclave "$ex" --work "$out/w-$n-plain" # AppArmor label (12), once
    fi
    if $plain && [ "$ex" = "$1" ]; then step "suite-$n-debug" debug_suite "$ex" "$n"; fi
    $oracles || continue
    step "resolve-$n" py "$here/oracle_resolve.py" --exclave "$ex" --work "$out/r-$n"
    step "ns-$n" py "$here/oracle_ns.py" --exclave "$ex" --work "$out/n-$n"
    step "syscalls-$n" py "$here/oracle_syscalls.py" --exclave "$ex" --work "$out/s-$n"
    if [ -n "${EXCLAVE_TEST_INPUTS:-}" ]; then
        step "docker-$n" py "$here/docker_profile.py" --exclave "$ex" --profile "$EXCLAVE_TEST_INPUTS/src/docker-seccomp.json" --work "$out/d-$n"
    fi
done
# the command's C answers against its Python ones, while it is ported (18 item 1)
if $port; then
    given=
    for ex in "$@"; do given="$given --exclave $ex"; done
    # shellcheck disable=SC2086  # one word per --exclave and path
    step port py "$here/tool_oracle.py" $given --work "$out/port"
fi
if [ -n "${EXCLAVE_TEST_INPUTS:-}" ]; then
    $dogfood && step dogfood py "$here/dogfood.py" --inputs "$EXCLAVE_TEST_INPUTS" --work "$out/dogfood"
else
    echo "docker, dogfood: EXCLAVE_TEST_INPUTS not set; skipped"
fi
wait

fails=0 skips=0
for rc in "$out"/*.rc; do
    name=$(basename "$rc" .rc)
    read -r r secs <"$rc"
    last=$(grep -v '^$' "$out/$name.log" | tail -1 | cut -c1-110)
    if [ "$r" != 0 ]; then
        printf '%-22s FAIL %4ss  %s\n' "$name" "$secs" "$last"
        fails=$((fails + 1))
    elif case $name in resolve-* | ns-* | syscalls-* | docker-*) grep -q 'cannot run' "$out/$name.log" ;; *) false ;; esac then
        printf '%-22s SKIP %4ss  %s\n' "$name" "$secs" "$last"
        skips=$((skips + 1)) # an oracle without bwrap, namespaces or openat2
    else printf '%-22s ok   %4ss  %s\n' "$name" "$secs" "$last"; fi
done
echo "gate: $fails failed, $skips skipped, $(($(date +%s) - start)) s"
exit $fails
