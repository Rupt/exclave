#!/bin/sh
# scripts/gate [--full] [--since REV] [--jobs N] EXCLAVE — the commit gate (DESIGN.md 17), run on the change at hand.
#
# It is the one gate, and it is fast: every step is a test that fails on a case with the answer expected, in
# seconds. It builds the launchers and the command first (scripts/build), which takes no time when they are up to date. Then by
# default it runs the steps the changed paths can affect: the uncommitted changes, or, in a clean tree, the last
# commit; --since REV takes the commits after REV too, so that a series is gated once. test/affected.py derives
# the steps from what each step runs, through the drivers' imports and the paths they name: a launcher source or
# its build runs everything; the tool, a test or a helper runs the steps that use it; documents, scripts and
# settings run the code checks alone; a path nothing names runs everything. --full runs every step, whatever
# changed.
#
# The steps: the code checks (scripts/check), the unit tests under ASan and UBSan, the stack budget, the
# command's Go unit tests and fuzz seeds (go test), unpack's tests on hostile package files (test/unpack_test.py), the
# fetchers' signature checks (test/fetch_test.py), and on the exclave given the suite, the resolution oracle, the namespace oracle, the syscall probe and, when
# EXCLAVE_TEST_INPUTS names the directory scripts/inputs filled, the Docker profile run on its
# src/docker-seccomp.json. No step touches the network. Everything slower or broader is scripts/extra's and
# scripts/matrix's, run when the user asks. The steps run two at a time, or N with --jobs, so that the machine
# stays usable meanwhile; every driver runs build/launcher on a copy of its own (the suite wraps one from the
# exclave's tree, the oracles keep test/tree.py's kept_worlds, the others take its fresh_exclave), so the exclave
# given is never run as it is nor written. One line per step with its time, SKIP for an oracle that could not run
# here; logs under build/gate/.
# Exit status: the number of failed steps.
set -u
. "$(dirname -- "$0")/lib.sh"
here=$ROOT/test
repo=$ROOT
out=$repo/build/gate
full=false jobs=2 since='' seed=''
while :; do
    case ${1-} in
    --full) full=true ;;
    --jobs)
        jobs=${2-}
        shift
        ;;
    --since) # the commits after REV, and the uncommitted changes: a series gated once
        since=${2-}
        shift
        ;;
    *) break ;;
    esac
    shift
done
case $jobs in '' | *[!0-9]* | 0) jobs=0 ;; esac
[ $# -eq 1 ] && [ "$jobs" -gt 0 ] || {
    echo "usage: scripts/gate [--full] [--since REV] [--jobs N] EXCLAVE" >&2
    exit 2
}
ex=$1
"$ROOT/scripts/build" || exit 2 # the launchers and the command, unless they are up to date
rm -rf "$out" && mkdir -p "$out" || exit 2
. "$ROOT/scripts/steps.sh"
start=$(date +%s)

# shellcheck disable=SC2329  # run through step, by name
# the parser, the filter, the scratch pool, the cache's lock, the CPU check and the #! rules, just built for the
# host under the sanitisers, the six builds one after the other (a build never loads the machine with more than
# one compiler); the command's grammar and readers on hostile files, through build/exclave
unit() {
    sanitized "$out/manifest_test" -DHOST_TEST "$here/manifest_test.c" "$repo/src/manifest.c" "$repo/src/str.c" &&
        sanitized "$out/filter_test" -DHOST_TEST "$here/filter_test.c" "$repo/src/filter.c" "$repo/src/str.c" &&
        sanitized "$out/scratch_test" -DSCRATCH_TEST "$here/scratch_test.c" "$repo/src/scratch.c" &&
        sanitized "$out/cache_test" -DHOST_TEST "$here/cache_test.c" "$repo/src/cache.c" "$repo/src/str.c" &&
        sanitized "$out/isa_test" -DHOST_TEST "$here/isa_test.c" "$repo/src/isa.c" "$repo/src/str.c" &&
        sanitized "$out/str_test" -DHOST_TEST "$here/str_test.c" "$repo/src/str.c" &&
        "$out/manifest_test" && py "$here/grammar_test.py" --c-parser "$out/manifest_test" &&
        py "$here/readers_test.py" --work "$out/readers" &&
        "$out/filter_test" && py "$here/syscalls.py" && py "$here/tables_test.py" && "$out/scratch_test" &&
        "$out/cache_test" && "$out/isa_test" && "$out/str_test"
}
# shellcheck disable=SC2329  # run through step, by name
stack() {
    py "$here/stackcheck.py" "$repo"/build/launcher.debug-*.ci || return 1
    if ls "$repo"/build/launcher-aarch64.debug-*.ci >/dev/null 2>&1; then py "$here/stackcheck.py" "$repo"/build/launcher-aarch64.debug-*.ci; fi
}

# The steps the change can affect, derived by test/affected.py from what each step runs.
changed=$(cd "$ROOT" && { git diff --name-only "${since:-HEAD}" && git ls-files --others --exclude-standard; } | sort -u)
what=${since:+"the changes since $since"}
what=${what:-"uncommitted changes"}
if [ -z "$changed" ]; then
    if (cd "$ROOT" && git rev-parse -q --verify HEAD~1 >/dev/null); then
        changed=$(cd "$ROOT" && git diff --name-only HEAD~1 HEAD)
        what="the last commit"
    else
        full=true what="a checkout without the last commit's parent, as a shallow clone is"
    fi
fi
# shellcheck disable=SC2086  # the changed paths, one word each
steps=$(py "$here/affected.py" $changed | tr '\n' ' ') || exit 2
has() {
    case " $steps " in *" $1 "*) return 0 ;; esac
    return 1
} # has STEP: whether the change reaches it
if $full || has every; then
    steps="unit stack go unpack fetch suite oracles $steps"
    # the resolution oracle's mazes from a seed of the moment rather than the commit's, printed on a failure
    $full && seed=$(($(date +%s) % 100000))
    echo "gate: every step ($what${changed:+: $(echo "$changed" | wc -l) paths})"
else
    echo "gate: the steps $what can affect ($(echo "$changed" | wc -l) paths); --full runs every step"
fi
has matrix && echo "gate: the change reaches the VMs: scripts/matrix is due, and runs when approved"

# shellcheck disable=SC2329  # run through step, by name
gostep() { # the command's unit tests and fuzz seeds, and the modules in the cache as go.sum records them
    "$GO" -C "$ROOT" test ./tool/... ./fetch/... ./unpack/... && "$GO" -C "$ROOT" mod verify
}

n=$(basename "$ex" .exclave)
step check "$ROOT/scripts/check" # ruff, ty, shellcheck, shfmt and taplo, silent when clean
has unit && step unit unit
has stack && step stack stack
has go && step go gostep                                                 # the command's Go tests, go.sum verified
has unpack && step unpack py "$here/unpack_test.py" --work "$out/unpack" # unpack's rules on hostile package files
has fetch && step fetch py "$here/fetch_test.py" --work "$out/fetch"     # the fetchers' signature checks
has suite && step "suite-$n" py "$here/run.py" --exclave "$ex" --work "$out/w-$n"
if has oracles; then
    step "resolve-$n" py "$here/oracle_resolve.py" --exclave "$ex" --work "$out/r-$n" ${seed:+--seed "$seed"}
    step "ns-$n" py "$here/oracle_ns.py" --exclave "$ex" --work "$out/n-$n"
    step "syscalls-$n" py "$here/oracle_syscalls.py" --exclave "$ex" --work "$out/s-$n"
    if [ -n "${EXCLAVE_TEST_INPUTS:-}" ]; then
        step "docker-$n" py "$here/docker_profile.py" --exclave "$ex" --profile "$EXCLAVE_TEST_INPUTS/src/docker-seccomp.json" --work "$out/d-$n"
    else echo "docker: EXCLAVE_TEST_INPUTS not set; skipped"; fi
fi
wait
report gate "$start"
