#!/bin/sh
# scripts/matrix: the kernel matrix in virtual machines (docs/DESIGN.md 12.1, 17), run by the pinned Python (scripts/lib.sh).
# It builds the launchers and the command first (scripts/build), which takes no time when they are up to date: the
# arm64 rows run the cross build as it is, where an x86-64 row builds the launcher again in its VM and compares.
set -eu
. "$(dirname -- "$0")/lib.sh"
"$ROOT/scripts/build" || exit 2
exec "$UV" run --quiet --project "$ROOT" python "$ROOT/test/matrix.py" "$@"
