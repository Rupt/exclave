#!/bin/sh
# scripts/release DIR TOOLCHAIN [EXCLAVE...] — a release (docs/DESIGN.md 10.5): under DIR, exclave-N-ARCH.tar.gz, N
# the version and ARCH this machine's, an archive of the directory exclave-N-ARCH holding the command, exclave, and
# exclave-fetch, executable as they unpack, with LICENSE and, as NOTICES, the licence texts of Go and of the Go
# modules they link; each exclave named as NAME.exclave.tar.zst, zstd's level 19; and SHA256SUMS over every file
# there. The commands' archive is gzip's, which every host's tar unpacks, and the same bytes from the same files:
# names sorted, no owner, the commit's time. The launcher is built inside TOOLCHAIN, a gcc
# exclave, and the command here from it, by scripts/reproduce, so that its bytes are that compiler's; each exclave
# must be wrapped with that launcher, and passes `exclave check` first. A release is of a commit and of nothing else:
# DIR must be empty or absent, since every file in it is summed, and a tree with changes its commit does not hold is
# refused, since the build would name itself -dirty. The release test and the matrix, which run the recipe on the
# tree as it stands, set EXCLAVE_RELEASE_UNCOMMITTED=1. docs/RELEASE.md says how a release is made, checked and taken
# with nothing but its own files; test/release_test.py runs that recipe.
set -eu
. "$(dirname -- "$0")/lib.sh"
[ $# -ge 2 ] || {
    echo "usage: scripts/release DIR TOOLCHAIN [EXCLAVE...]" >&2
    exit 2
}
dir=$1 toolchain=$2
shift 2
[ $# -eq 0 ] || command -v zstd >/dev/null 2>&1 || {
    echo "release: no zstd here: the archives are zstd's" >&2
    exit 2
}
if [ -e "$dir" ] && [ -n "$(ls -A "$dir")" ]; then
    echo "release: $dir is not empty: every file in it would be summed with the release's" >&2
    exit 2
fi
# what scripts/reproduce copies, untracked files with it, and the name the build takes from the commit
if [ -z "${EXCLAVE_RELEASE_UNCOMMITTED:-}" ] && git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    case $(git -C "$ROOT" describe --always --dirty --exclude='*') in
    *-dirty)
        echo "release: the tree has changes its commit does not hold; a release is of a commit" >&2
        exit 1
        ;;
    esac
    stray=$(git -C "$ROOT" status --porcelain -- src tool unpack fetch scripts go.mod go.sum LICENSE VERSION)
    [ -z "$stray" ] || {
        echo "release: files the commit does not hold lie among the sources; a release is of a commit:" >&2
        printf '%s\n' "$stray" >&2
        exit 1
    }
fi
built=$ROOT/build/reproduce
"$ROOT/scripts/reproduce" "$toolchain" "$built"
command=$built/build/exclave
[ -x "$command" ] || {
    echo "release: scripts/reproduce built no command: it needs the pinned Go (scripts/install-go)" >&2
    exit 2
}
mkdir -p "$dir"
for ex; do
    ex=${ex%/}
    name=$(basename -- "$ex")
    case $name in
    *.exclave) ;;
    *)
        echo "release: $ex is not named NAME.exclave" >&2
        exit 2
        ;;
    esac
    [ -d "$ex/.exclave" ] || {
        echo "release: $ex is not wrapped" >&2
        exit 2
    }
    cmp -s "$ex/.exclave/launcher" "$built/build/launcher" || {
        echo "release: $ex is wrapped with another launcher than the one built from $toolchain; relink it with the" >&2
        echo "release: command built there: $command relink $ex" >&2
        exit 1
    }
    "$command" check "$ex" >/dev/null || {
        echo "release: $ex does not pass exclave check" >&2
        exit 1
    }
    # hard links kept, so the wrappers stay links to the launcher; names sorted and no owner, so the archive
    # does not depend on the machine that made it
    tar -C "$(dirname -- "$ex")" --sort=name --owner=0 --group=0 --numeric-owner -cf - "$name" |
        zstd -q -19 -T0 >"$dir/$name.tar.zst" # the same bytes on any number of threads
    echo "release: $name ($(stat -c %s "$dir/$name.tar.zst") bytes)"
done
arch=$(uname -m)
version=$("$command" version)
n=${version#exclave }
n=${n%%+*}
pkg=exclave-$n-$arch
stage=$(mktemp -d)
mkdir "$stage/$pkg"
cp "$command" "$stage/$pkg/exclave"
cp "$built/build/exclave-fetch" "$stage/$pkg/exclave-fetch"
cp "$built/build/NOTICES" "$stage/$pkg/NOTICES"
cp "$ROOT/LICENSE" "$stage/$pkg/LICENSE"
chmod 755 "$stage/$pkg" "$stage/$pkg/exclave" "$stage/$pkg/exclave-fetch"
chmod 644 "$stage/$pkg/NOTICES" "$stage/$pkg/LICENSE"
when=$(git -C "$ROOT" log -1 --format=%ct 2>/dev/null) || when=0
tar -C "$stage" --sort=name --owner=0 --group=0 --numeric-owner --mtime="@$when" -cf - "$pkg" |
    gzip -n -9 >"$dir/$pkg.tar.gz"
rm -rf "$stage"
cd "$dir"
set -- *
sha256sum "$@" >SHA256SUMS
echo "release: $dir holds $(($# + 1)) files, their sums among them; $version"
