#!/bin/sh
# scripts/release KEY DIR TOOLCHAIN [EXCLAVE...] — a release (docs/DESIGN.md 10.5): under DIR, the command as
# exclave-ARCH and exclave-fetch-ARCH, ARCH this machine's, with LICENSE and, as NOTICES, the licence texts of Go and
# of the Go modules they link; each exclave named as NAME.exclave.tar.zst, zstd's level 19; SHA256SUMS and B3SUMS over
# every file there, the second as b3sum writes it, by the command; and SHA256SUMS.sig, the sums signed with the ssh
# private key KEY (ssh-keygen -Y, in the namespace "exclave"). The launcher is built inside TOOLCHAIN, a gcc exclave,
# and the command here from it, by scripts/reproduce, so that anyone can build the same bytes; each exclave must be
# wrapped with that launcher, and passes `exclave check` first. A release is of a commit and of nothing else: DIR must
# be empty or absent, since every file in it is summed and signed, and a tree with changes its commit does not hold
# is refused, since the build would name itself -dirty. The release test and the matrix, which run the recipe on the
# tree as it stands, set EXCLAVE_RELEASE_UNCOMMITTED=1. The README says how a consumer verifies and takes a release
# with nothing but its own files; test/release_test.py runs that recipe.
set -eu
. "$(dirname -- "$0")/lib.sh"
[ $# -ge 3 ] || {
    echo "usage: scripts/release KEY DIR TOOLCHAIN [EXCLAVE...]" >&2
    exit 2
}
key=$1 dir=$2 toolchain=$3
shift 3
[ $# -eq 0 ] || command -v zstd >/dev/null 2>&1 || {
    echo "release: no zstd here: the archives are zstd's" >&2
    exit 2
}
[ -r "$key" ] || {
    echo "release: cannot read the key $key" >&2
    exit 2
}
if [ -e "$dir" ] && [ -n "$(ls -A "$dir")" ]; then
    echo "release: $dir is not empty: every file in it would be summed and signed with the release's" >&2
    exit 2
fi
# what scripts/reproduce copies, untracked files with it, and the name the build takes from the commit
if [ -z "${EXCLAVE_RELEASE_UNCOMMITTED:-}" ] && git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    case $(git -C "$ROOT" describe --always --dirty --exclude='*') in
    *-dirty)
        echo "release: the tree has changes its commit does not hold; a release is of a commit" >&2
        exit 1
        ;;
    esac
    stray=$(git -C "$ROOT" status --porcelain -- src tool unpack fetch scripts go.mod go.sum LICENSE VERSION)
    [ -z "$stray" ] || {
        echo "release: files the commit does not hold lie among the sources; a release is of a commit:" >&2
        printf '%s\n' "$stray" >&2
        exit 1
    }
fi
built=$ROOT/build/reproduce
"$ROOT/scripts/reproduce" "$toolchain" "$built"
command=$built/build/exclave
[ -x "$command" ] || {
    echo "release: scripts/reproduce built no command: it needs the pinned Go (scripts/install-go)" >&2
    exit 2
}
mkdir -p "$dir"
for ex; do
    ex=${ex%/}
    name=$(basename -- "$ex")
    case $name in
    *.exclave) ;;
    *)
        echo "release: $ex is not named NAME.exclave" >&2
        exit 2
        ;;
    esac
    [ -d "$ex/.exclave" ] || {
        echo "release: $ex is not wrapped" >&2
        exit 2
    }
    cmp -s "$ex/.exclave/launcher" "$built/build/launcher" || {
        echo "release: $ex is wrapped with another launcher than the one built from $toolchain; relink it with the" >&2
        echo "release: command built there: $command relink $ex" >&2
        exit 1
    }
    "$command" check "$ex" >/dev/null || {
        echo "release: $ex does not pass exclave check" >&2
        exit 1
    }
    # hard links kept, so the wrappers stay links to the launcher; names sorted and no owner, so the archive
    # does not depend on the machine that made it
    tar -C "$(dirname -- "$ex")" --sort=name --owner=0 --group=0 --numeric-owner -cf - "$name" |
        zstd -q -19 -T0 >"$dir/$name.tar.zst" # the same bytes on any number of threads
    echo "release: $name ($(stat -c %s "$dir/$name.tar.zst") bytes)"
done
arch=$(uname -m)
cp "$command" "$dir/exclave-$arch"
cp "$built/build/exclave-fetch" "$dir/exclave-fetch-$arch"
cp "$built/build/NOTICES" "$dir/NOTICES"
cp "$ROOT/LICENSE" "$dir/LICENSE"
cd "$dir"
set -- *
sha256sum "$@" >SHA256SUMS
for f; do printf '%s  %s\n' "$("$command" hash "$f" | sed 's/^b3://')" "$f"; done >B3SUMS
ssh-keygen -q -Y sign -f "$key" -n exclave SHA256SUMS
echo "release: $dir holds $(($# + 3)) files, the sums signed; $("./exclave-$arch" version)"
