#!/bin/sh
# The code checks: format, lint and type checks for the Python, the Go, the C,
# the shell scripts and the TOML, every tool from uv.lock (pyproject.toml's dev
# group) or go.mod's tool directives but gcc, the machine's, which builds the
# launcher and is asked for its warnings. scripts/gate runs this as a step.
#
#   scripts/check [PATH...]        report; exit non-zero on any finding
#   scripts/check --fix [PATH...]  let ruff and the formatters write their corrections
#
# Every check runs, whatever an earlier one found. A pass says nothing: each
# tool is asked for its quietest form. Given the changed PATHs, as the gate
# gives them, the C's and the Go's checks run only where a path reaches them
# (a source, a header, the flags or a tool's settings); the Python's, the
# shell's and the TOML's, which take seconds, and the figures always run.
set -u

. "$(dirname -- "$0")/lib.sh"
cd "$ROOT" || exit 2

fix=false
[ "${1-}" = --fix ] && fix=true && shift
# reaches PATTERN...: no PATH was given, or one matches a PATTERN (a case pattern)
reaches() {
    [ -z "$paths" ] && return 0
    for p in $paths; do
        for pat; do
            # shellcheck disable=SC2254  # the pattern is meant to match
            case $p in $pat) return 0 ;; esac
        done
    done
    return 1
}
paths=$*
c=false go=false
# what every check rests on: this script, the flags lib.sh gives, the toolchains' pins
reaches scripts/check scripts/lib.sh uv.lock pyproject.toml && c=true go=true
reaches 'src/*' 'test/*.c' 'test/*.h' 'test/progs/*' .clang-format .clang-tidy && c=true
reaches 'tool/*' 'fetch/*' 'unpack/*' go.mod go.sum scripts/install-go 'src/*' && go=true

# Bring .venv up to date once; every run below then uses it as it is.
need_uv || exit 2
"$UV" sync --quiet || exit 2
export UV_NO_SYNC=1

[ -x "$GO" ] || {
    echo "check: no Go at $GO; run scripts/install-go" >&2
    exit 2
}

# The shell scripts, in the positional parameters: every file under scripts/
# that starts as a POSIX shell script, and lib.sh and steps.sh, which are sourced.
set -- scripts/lib.sh scripts/steps.sh
for path in scripts/*; do
    case "$(head -n 1 "$path")" in
    '#!/bin/sh'*) set -- "$@" "$path" ;;
    esac
done

status=0
run() { "$@" || status=1; }

if $fix; then
    # ruff's fixes first, so that the formatter has the last word on layout
    run "$UV" run --quiet ruff check --fix .
    run "$UV" run --quiet ruff format .
    run "$UV" run --quiet shfmt --indent 4 --posix --simplify --write "$@"
    ! $c || run "$UV" run --quiet clang-format -i src/*.[ch] test/*.c test/progs/*.c
    if [ -x .venv/bin/taplo ]; then run env RUST_LOG=warn "$UV" run --quiet taplo fmt pyproject.toml; fi
else
    run "$UV" run --quiet ruff format --check --quiet .
    run "$UV" run --quiet ruff check --quiet .
    run "$UV" run --quiet shfmt --indent 4 --posix --simplify --diff "$@"
    ! $c || run "$UV" run --quiet clang-format --dry-run --Werror src/*.[ch] test/*.c test/progs/*.c
    if [ -x .venv/bin/taplo ]; then run env RUST_LOG=warn "$UV" run --quiet taplo fmt --check --diff pyproject.toml; fi
fi
# on an aarch64 machine neither is installed (pyproject.toml): the shell and the TOML are checked on x86-64
[ -x .venv/bin/taplo ] || echo "check: no taplo for $(uname -m); pyproject.toml's format unchecked here"
if [ -x .venv/bin/shellcheck ]; then
    run "$UV" run --quiet shellcheck --severity=style --shell=sh \
        --external-sources --source-path=SCRIPTDIR "$@"
else
    echo "check: no shellcheck for $(uname -m); the shell scripts unchecked here"
fi
run "$UV" run --quiet ty check --quiet

# The C, formatted above (.clang-format), checked a process to a file. First
# gcc's warnings as errors and its analyser, nothing kept: the launcher's
# sources for each architecture there is a compiler for, and the unit tests'
# for the host (lib.sh's flags). Then
# clang-tidy (.clang-tidy) on the launcher and on the unit tests. The
# warnings are asked for every source on every architecture, since the
# headers' types and numbers differ by architecture; the analyser's and
# clang-tidy's paths on aarch64 only for a source that holds aarch64's own
# code, since elsewhere they are x86-64's paths again. A file's output is
# shown only for a finding, since clang counts aloud the warnings it suppressed.
# Each check that passes is recorded under build/check/ by a key of all it
# reads: the file, every header, the flags lib.sh gives, this script, the
# tools' settings and versions, and the check's own command. A check whose key
# is recorded has passed on these very inputs and is not run again, so a
# change reanalyses the files it touches, every one for a header.
# shellcheck disable=SC2329  # run through run, by name
quiet() { # quiet CMD...: CMD's output only when it fails
    out=$("$@" 2>&1) || {
        printf '%s\n' "$out"
        return 1
    }
}
# compiled FILE CC ARGS...: FILE compiled with CC's flags and ARGS as a check, twice, one after the other, as
# every compile and clang-tidy run below is, so that the check never loads the machine with more than one
# process (the laptop is in use beside it): once as built, for the warnings, and once at -O0 under gcc's analyser, which follows the paths of the code as written
# (null and uninitialised uses, memory and descriptors freed twice or never, writes past a bound), since
# optimisation folds some of them away first. gcc 14 defines __ANALYZER__ under the analyser; gcc 13 is given
# it, and sys.h makes the syscalls opaque calls under it, as the analyser cannot see what the kernel writes.
stamps=$ROOT/build/check
# what every C check reads besides its own file
inputs=$(
    {
        cat src/*.h test/*.h scripts/lib.sh scripts/check .clang-tidy
        "${CC:-gcc}" --version
        ! command -v aarch64-linux-gnu-gcc >/dev/null || aarch64-linux-gnu-gcc --version
        .venv/bin/clang-tidy --version
    } 2>&1 | sha256sum | cut -c1-64
)
# recorded FILE CMD...: CMD, a check of FILE, unless it passed before on the same inputs; a pass is recorded
# shellcheck disable=SC2329  # run through run, by name
recorded() {
    key=$({
        echo "$inputs $*"
        cat "$1"
    } | sha256sum | cut -c1-64)
    shift
    [ -e "$stamps/$key" ] && return 0
    "$@" && mkdir -p "$stamps" && : >"$stamps/$key"
}
# warned FILE CC ARGS...: FILE compiled with CC's flags and ARGS for the warnings; analysed, under the analyser
warned() {
    f=$1
    shift
    run recorded "$f" quiet "$@" "$f" -Werror -c -o /dev/null
}
analysed() {
    f=$1
    shift
    run recorded "$f" quiet "$@" "$f" -O0 -fanalyzer -D__ANALYZER__ -Werror -c -o /dev/null
}
compiled() {
    warned "$@"
    analysed "$@"
}
# own FILE ARCH: ARCH is the machine's, or FILE holds code of an architecture's own
own() { [ "$2" = "$(uname -m)" ] || grep -qE "__(x86_64|aarch64)__" "$1"; }
if $c; then
    for f in src/*.c; do
        for arch in $(c_arches); do
            warned "$f" launcher_cc "$arch"
            if own "$f" "$arch"; then analysed "$f" launcher_cc "$arch"; fi
        done
    done
    # the unit tests' and the fuzz target's own files, and the launcher's sources they are built with (lib.sh's unit_tests)
    for f in test/*_test.c test/sanitize.c test/fuzz.c test/*_fuzz.c $(unit_tests | cut -d' ' -f2- | tr ' ' '\n' | sort -u); do
        compiled "$f" host_cc -DHOST_TEST
    done
    # the test programs too, but for string literals in an exec's argv, its natural spelling
    for f in test/progs/*.c; do
        run recorded "$f" quiet host_cc -pthread -Wno-discarded-qualifiers "$f" -Werror -c -o /dev/null
    done
    for target in x86_64 aarch64; do
        for f in src/*.c; do
            if own "$f" "$target"; then
                run recorded "$f" quiet .venv/bin/clang-tidy --quiet "$f" -- --target=$target-linux-gnu -std=gnu11 -ffreestanding -fno-builtin -nostdlib
            fi
        done
    done
    for f in test/*_test.c test/sanitize.c test/fuzz.c test/*_fuzz.c; do
        run recorded "$f" quiet .venv/bin/clang-tidy --quiet "$f" -- -std=gnu11 -DHOST_TEST
    done
    # no C line over 120 columns, a table between clang-format off and on aside:
    # clang-format leaves comments as written, so it does not hold them to it
    if awk '/clang-format off/ { off = 1 } /clang-format on/ { off = 0 }
        !off && length > 120 { print FILENAME ":" FNR ": over 120 columns"; bad = 1 } END { exit bad }' \
        src/*.[ch] test/*.c test/progs/*.c; then :; else status=1; fi
    # a definition in a shared header that nothing uses, which no compiler reports
    run "$UV" run --quiet python test/c_unused.py
fi

# The Go, the command's packages (go.mod; copies under build/ are left out): gofmt's layout
# simplified, go fix's modernisations, then go vet, staticcheck and deadcode, the last two the
# versions go.mod's tool directives pin, run through the pinned toolchain. Each runs one after
# the other. A line over 120 columns, a tab counted as four, is held to the C's rule. The
# command embeds the launcher scripts/build copies to tool/, so the Go is checked after a build.
gopkgs="./tool/... ./fetch/... ./unpack/..."
if ! $go; then
    :
elif [ -e "tool/launcher-$(uname -m)" ]; then
    # shellcheck disable=SC2086  # the packages, one word each
    godirs=$("$GO" list -f '{{.Dir}}' $gopkgs) || status=1
    if $fix; then
        # shellcheck disable=SC2086  # the directories, one word each
        run "$GOFMT" -l -s -w $godirs
        # shellcheck disable=SC2086  # the packages, one word each
        run quiet "$GO" fix $gopkgs
    else
        # shellcheck disable=SC2086  # the directories, one word each
        if unformatted=$("$GOFMT" -l -s $godirs) && [ -n "$unformatted" ]; then
            printf '%s: not as gofmt -s lays it out\n' $unformatted
            status=1
        fi
        # shellcheck disable=SC2086  # the packages, one word each
        run quiet "$GO" fix -diff $gopkgs
    fi
    # shellcheck disable=SC2086  # the packages, one word each
    run quiet "$GO" vet $gopkgs
    # shellcheck disable=SC2086  # the packages, one word each
    run quiet "$GO" tool staticcheck $gopkgs
    # shellcheck disable=SC2086  # the packages, one word each
    run quiet "$GO" tool deadcode -test $gopkgs
    if awk '{ gsub(/\t/, "    ") } length > 120 { print FILENAME ":" FNR ": over 120 columns"; bad = 1 } END { exit bad }' \
        tool/*.go tool/*/*.go fetch/*.go unpack/*.go unpack/*/*.go; then :; else status=1; fi
else
    echo "check: no tool/launcher-$(uname -m) for the command to embed; run scripts/build: the Go is unchecked" >&2
    status=1
fi

# A suppression says why on its line: `# noqa: RULE -- reason`.
if grep -rnE '# (noqa: [A-Z0-9, ]+|ty: ignore\[[a-z0-9, -]+\])$' --include='*.py' test src; then
    echo "check: a suppression above gives no reason" >&2
    status=1
fi

# Every figure a document quotes that the tree can produce is the tree's (test/figures.py).
if ! "$UV" run --quiet python test/figures.py --check; then
    echo "check: a document quotes a figure the tree does not give" >&2
    status=1
fi
exit $status
