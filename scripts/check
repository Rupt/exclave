#!/bin/sh
# The code checks: format, lint and type checks for the Python, the C, the
# shell scripts and the TOML, every tool from uv.lock (pyproject.toml's dev
# group) but gcc, the machine's, which builds the launcher and is asked for its
# warnings. scripts/gate runs this as a step.
#
#   scripts/check          report; exit non-zero on any finding
#   scripts/check --fix    let ruff and the formatters write their corrections
#
# Every check runs, whatever an earlier one found. A pass says nothing: each
# tool is asked for its quietest form.
set -u

. "$(dirname -- "$0")/lib.sh"
cd "$ROOT" || exit 2

fix=false
[ "${1-}" = --fix ] && fix=true

# Bring .venv up to date once; every run below then uses it as it is.
"$UV" sync --quiet || exit 2
export UV_NO_SYNC=1

[ -x "$GO" ] || {
    echo "check: no Go at $GO; run scripts/install-go" >&2
    exit 2
}

# The shell scripts, in the positional parameters: every file under scripts/
# that starts as a POSIX shell script, and lib.sh and steps.sh, which are sourced.
set -- scripts/lib.sh scripts/steps.sh
for path in scripts/*; do
    case "$(head -n 1 "$path")" in
    '#!/bin/sh'*) set -- "$@" "$path" ;;
    esac
done

status=0
run() { "$@" || status=1; }

if $fix; then
    # ruff's fixes first, so that the formatter has the last word on layout
    run "$UV" run --quiet ruff check --fix .
    run "$UV" run --quiet ruff format .
    run "$UV" run --quiet shfmt --indent 4 --posix --simplify --write "$@"
    run "$UV" run --quiet clang-format -i src/*.[ch] tool/*.[ch] test/*.c test/progs/*.c
    if [ -x .venv/bin/taplo ]; then run env RUST_LOG=warn "$UV" run --quiet taplo fmt pyproject.toml; fi
else
    run "$UV" run --quiet ruff format --check --quiet .
    run "$UV" run --quiet ruff check --quiet .
    run "$UV" run --quiet shfmt --indent 4 --posix --simplify --diff "$@"
    run "$UV" run --quiet clang-format --dry-run --Werror src/*.[ch] tool/*.[ch] test/*.c test/progs/*.c
    if [ -x .venv/bin/taplo ]; then run env RUST_LOG=warn "$UV" run --quiet taplo fmt --check --diff pyproject.toml; fi
fi
# on an aarch64 machine neither is installed (pyproject.toml): the shell and the TOML are checked on x86-64
[ -x .venv/bin/taplo ] || echo "check: no taplo for $(uname -m); pyproject.toml's format unchecked here"
if [ -x .venv/bin/shellcheck ]; then
    run "$UV" run --quiet shellcheck --severity=style --shell=sh \
        --external-sources --source-path=SCRIPTDIR "$@"
else
    echo "check: no shellcheck for $(uname -m); the shell scripts unchecked here"
fi
run "$UV" run --quiet ty check --quiet

# The C, formatted above (.clang-format), checked a process to a file. First
# gcc's warnings as errors and its analyser, nothing kept: the launcher's
# sources for each architecture there is a compiler for and as
# build/launcher-old, the command's for each architecture, and the unit
# tests' for the host (lib.sh's flags). Then clang-tidy (.clang-tidy) on the
# launcher for each architecture and on the unit tests. A file's output is
# shown only for a finding, since clang counts aloud the warnings it suppressed.
# shellcheck disable=SC2329  # run through run, by name
quiet() { # quiet CMD...: CMD's output only when it fails
    out=$("$@" 2>&1) || {
        printf '%s\n' "$out"
        return 1
    }
}
# compiled CC ARGS... FILE: FILE compiled with CC's flags and ARGS as a check, twice, one after the other, as
# every compile and clang-tidy run below is, so that the check never loads the machine with more than one
# process (the laptop is in use beside it): once as built, for the warnings, and once at -O0 under gcc's analyser, which follows the paths of the code as written
# (null and uninitialised uses, memory and descriptors freed twice or never, writes past a bound), since
# optimisation folds some of them away first. gcc 14 defines __ANALYZER__ under the analyser; gcc 13 is given
# it, and sys.h makes the syscalls opaque calls under it, as the analyser cannot see what the kernel writes.
compiled() {
    run quiet "$@" -Werror -c -o /dev/null
    run quiet "$@" -O0 -fanalyzer -D__ANALYZER__ -Werror -c -o /dev/null
}
for f in src/*.c; do
    for arch in $(c_arches); do
        compiled launcher_cc "$arch" "$f"
    done
    compiled launcher_cc "$(uname -m)" -DFILTER_VERSION=3 -DEXCLAVE_TEST_OLD "$f"
done
for f in test/*_test.c test/sanitize.c test/fuzz.c test/*_fuzz.c src/manifest.c src/filter.c src/isa.c src/str.c; do
    compiled host_cc -DHOST_TEST "$f"
done
compiled host_cc -DSCRATCH_TEST src/scratch.c
# the exclave command, on the C library, for each architecture there is a compiler for
for f in tool/*.c; do
    for arch in $(c_arches); do
        compiler=${CC:-gcc}
        [ "$arch" = "$(uname -m)" ] || compiler=$arch-linux-gnu-gcc
        compiled tool_cc "$compiler" "$f"
    done
    run quiet .venv/bin/clang-tidy --quiet "$f" -- -std=gnu11 -D_GNU_SOURCE
done
# the test programs too, but for string literals in an exec's argv, its natural spelling
for f in test/progs/*.c; do
    run quiet host_cc -pthread -Wno-discarded-qualifiers "$f" -Werror -c -o /dev/null
done
for target in x86_64 aarch64; do
    for f in src/*.c; do
        run quiet .venv/bin/clang-tidy --quiet "$f" -- --target=$target-linux-gnu -std=gnu11 -ffreestanding -fno-builtin -nostdlib
    done
done
# and build/launcher-old's variant of the two sources it changes
for f in src/filter.c src/handler.c; do
    run quiet .venv/bin/clang-tidy --quiet "$f" -- --target=x86_64-linux-gnu -std=gnu11 -ffreestanding -fno-builtin -nostdlib \
        -DFILTER_VERSION=3 -DEXCLAVE_TEST_OLD
done
for f in test/*_test.c test/sanitize.c test/fuzz.c test/*_fuzz.c; do
    run quiet .venv/bin/clang-tidy --quiet "$f" -- -std=gnu11
done
# no C line over 120 columns, a table between clang-format off and on aside:
# clang-format leaves comments as written, so it does not hold them to it
if awk '/clang-format off/ { off = 1 } /clang-format on/ { off = 0 }
    !off && length > 120 { print FILENAME ":" FNR ": over 120 columns"; bad = 1 } END { exit bad }' \
    src/*.[ch] tool/*.[ch] test/*.c test/progs/*.c; then :; else status=1; fi
# a definition in a shared header that nothing uses, which no compiler reports
run "$UV" run --quiet python test/c_unused.py

# The Go, the two commands' packages (go.mod; copies under build/ are left out): gofmt's layout, then go vet.
godirs=$("$GO" list -f '{{.Dir}}' ./fetch/... ./unpack/...) || status=1
if $fix; then
    # shellcheck disable=SC2086  # the directories, one word each
    run "$GOFMT" -l -w $godirs
else
    # shellcheck disable=SC2086  # the directories, one word each
    if unformatted=$("$GOFMT" -l $godirs) && [ -n "$unformatted" ]; then
        printf '%s: not as gofmt lays it out\n' $unformatted
        status=1
    fi
fi
run quiet "$GO" vet ./fetch/... ./unpack/...

# A suppression says why on its line: `# noqa: RULE -- reason`.
if grep -rnE '# (noqa: [A-Z0-9, ]+|ty: ignore\[[a-z0-9, -]+\])$' --include='*.py' unpack fetch test src; then
    echo "check: a suppression above gives no reason" >&2
    status=1
fi

# Every hashes file records the command's version, which is the project's.
if ! "$UV" run --quiet python -c '
import sys, tomllib
want = tomllib.load(open("pyproject.toml", "rb"))["project"]["version"]
sys.exit(f"#define TOOL_VERSION \"{want}\"" not in open("tool/tool.h").read())'; then
    echo "check: tool/tool.h's TOOL_VERSION differs from pyproject.toml's version" >&2
    status=1
fi

# Every figure a document quotes that the tree can produce is the tree's (test/figures.py).
if ! "$UV" run --quiet python test/figures.py --check; then
    echo "check: a document quotes a figure the tree does not give" >&2
    status=1
fi
exit $status
