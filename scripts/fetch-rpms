#!/bin/sh
# scripts/fetch-rpms: an rpm package closure, downloaded (docs/DESIGN.md 10.1): the exclave command's fetch rpms, as scripts/build built it.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
[ -x "$root/build/exclave" ] || {
    echo "no $root/build/exclave: run scripts/build" >&2
    exit 1
}
exec "$root/build/exclave" fetch rpms "$@"
