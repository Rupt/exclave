#!/bin/sh
# scripts/fetch-rpms: an rpm package closure, downloaded (docs/DESIGN.md 10.1): the fetch command as scripts/build built it.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
[ -x "$root/build/fetch" ] || {
    echo "no $root/build/fetch: run scripts/build" >&2
    exit 1
}
exec "$root/build/fetch" rpms "$@"
